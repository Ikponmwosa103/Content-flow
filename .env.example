# API runtime
NODE_ENV=development
PORT=5000
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Gemini AI provider. GEMINI_MODEL defaults to gemini-2.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# Exact browser origins allowed to call the API, comma-separated.
CORS_ALLOWED_ORIGINS=
# Optional Netlify URL values; each is also added as an exact CORS origin.
NETLIFY_URL=
DEPLOY_PRIME_URL=

# Frontend build (Netlify sets BASE_PATH and PORT in netlify.toml).
BASE_PATH=/
VITE_CLERK_PUBLISHABLE_KEY=
# API origin only, e.g. https://api.example.com; omit to use same-origin /api.
VITE_API_BASE_URL=
# Optional Clerk proxy URL, e.g. https://api.example.com/api/__clerk.
VITE_CLERK_PROXY_URL=

# Optional diagnostics / isolated integration-test database.
LOG_LEVEL=info
CONTENTFLOW_TEST_DATABASE_URL=
